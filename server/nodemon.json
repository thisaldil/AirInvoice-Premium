{
  "watch": [
    "server.js",
    "database.js",
    "controllers",
    "middleware",
    "models",
    "routes",
    "services",
    "utils"
  ],
  "ext": "js,json",
  "ignore": [
    "node_modules/**",
    "eng.traineddata",
    "uploads/**",
    "/tmp/uploads/**"
  ],
  "legacyWatch": true,
  "exec": "node server.js"
}
